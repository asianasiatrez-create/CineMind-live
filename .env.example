# .env.example
# Copy this file to .env and fill in real values before running the app locally.
TMDB_API_KEY=
GROQ_API_KEY=
OMDB_API_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
CINEMIND_SECRET=replace-this-with-a-secret
CINEMIND_DB=cinemind.db
# DEV_ALLOW_ADMIN_SIGNUP can be used in development if you choose to add a controlled backdoor (disabled by default)
DEV_ALLOW_ADMIN_SIGNUP=false
